datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  role  Role   @default(USER) // Default role is 'USER'
  
  // later one: we can add other fields like password
  // password String
}

enum Role {
  USER
  ADMIN
}
